// firestore.rules
//
// Production-ready Firestore security rules for Vibely.
// Deploy with: firebase deploy --only firestore:rules
//
// Design principles:
//  • Authenticated users can read/write only their own sensitive data.
//  • Public profile fields are readable by all authenticated users.
//  • Posts respect the post's own privacy field.
//  • Messages are only readable by participants of that conversation.
//  • No unauthenticated access to any document.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────
    function isAuth()          { return request.auth != null; }
    function isOwner(uid)      { return isAuth() && request.auth.uid == uid; }
    function isMine(docOwner)  { return isAuth() && request.auth.uid == docOwner; }

    // ── Users ──────────────────────────────────────────────────────────────
    match /Users/{uid} {
      // Public profile fields only — email/phone/blocklist/bookmarks/pinned
      // chats live in the private sub-document below instead. Any logged-in
      // user can read this document.
      allow read: if isAuth();

      // Only the account owner can create or fully update their document.
      allow create: if isOwner(uid);

      // Updates: owner only, and cannot escalate isVerified to true themselves.
      allow update: if isOwner(uid)
                    && (!request.resource.data.diff(resource.data).affectedKeys()
                           .hasAny(['isVerified']));

      // Deletion not permitted through client SDK — use Cloud Functions.
      allow delete: if false;

      // ── Notifications sub-collection ─────────────────────────────────────
      // Path matches what the app actually reads/writes (see
      // notification_service.dart / notification_repository.dart):
      // `Users/{uid}/notifications/{notifId}`.
      match /notifications/{notifId} {
        // Only the recipient reads their own notifications.
        allow read: if isOwner(uid);
        // Any authenticated user can send a notification to another user
        // (e.g. "X liked your post"), but it must honestly claim to be from
        // the caller and be one of the known types — otherwise anyone could
        // forge a notification appearing to be from an arbitrary other user.
        // Includes 'blocked', since ChatCubit.blockUser sends one of these.
        allow create: if isAuth()
                      && request.resource.data.fromUserId == request.auth.uid
                      && request.resource.data.type in
                         ['postLike', 'postComment', 'commentLike',
                          'commentReply', 'message', 'follow', 'mention',
                          'blocked'];
        // Only the recipient can mark as read / delete.
        allow update: if isOwner(uid);
        allow delete: if isOwner(uid);
      }

      // ── Private data sub-document ─────────────────────────────────────────
      // Email, phone, block lists, bookmarks, pinned chats, and close-friends
      // list live here instead of on the main Users/{uid} doc — none of
      // these should be readable by anyone but the account owner. (Notif-
      // ication preferences deliberately stay on the public doc instead —
      // see UserModel.toMap — since checking a recipient's preferences
      // before sending them a notification requires reading them cross-user.)
      match /private/{document} {
        allow read: if isOwner(uid);
        // The owner can write anything. Any other authenticated user may
        // ALSO write, but only if blockedByUids is the sole field being
        // changed — this is the one legitimate cross-user write needed:
        // ChatRepository.blockUser()/unblockUser() maintain a denormalized
        // reverse index so a blocked user can tell they've been blocked
        // from their own doc, without ever reading the blocker's data.
        allow write: if isOwner(uid)
                     || (isAuth() && request.resource.data.diff(resource.data)
                            .affectedKeys().hasOnly(['blockedByUids']));
      }
    }

    // ── Posts ──────────────────────────────────────────────────────────────
    match /Posts/{postId} {
      // Read: public posts visible to all; followers-only posts need the
      // reader to follow the author (checked via the author's Firestore doc).
      allow read: if isAuth() && (
            resource.data.privacy == 'public'
         || isMine(resource.data.uid)
         || (resource.data.privacy == 'followers'
             && exists(/databases/$(database)/documents/Users/$(resource.data.uid))
             && request.auth.uid in
                get(/databases/$(database)/documents/Users/$(resource.data.uid)).data.followersUids)
      );

      // Create: authenticated, and uid field must match caller.
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;

      // Update/delete: post owner only. The `uid` field is locked so an
      // owner can't reassign authorship of the post to someone else.
      allow update: if isMine(resource.data.uid)
                    && request.resource.data.uid == resource.data.uid;
      allow delete: if isMine(resource.data.uid);

      // ── Comments sub-collection ──────────────────────────────────────────
      // Path is lowercase `comments` (see post_repository.dart), and the
      // author field is `userId` (see PostsCubit.addComment).
      match /comments/{commentId} {
        allow read:   if isAuth();
        allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
        allow update: if isAuth() && resource.data.userId == request.auth.uid
                      && request.resource.data.userId == resource.data.userId;
        allow delete: if isAuth() && resource.data.userId == request.auth.uid;

        // ── Replies sub-collection ─────────────────────────────────────────
        match /replies/{replyId} {
          allow read:   if isAuth();
          allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
          allow update: if isAuth() && resource.data.userId == request.auth.uid
                        && request.resource.data.userId == resource.data.userId;
          allow delete: if isAuth() && resource.data.userId == request.auth.uid;
        }
      }
    }

    // ── Chats (1-to-1) ────────────────────────────────────────────────────
    // Chat document ID = sorted(uid1, uid2).join('_'), but the document's
    // FIELDS store the pair as `participants: [uidA, uidB]` — see
    // ChatRepository.sendMessage() / ensureChatDoc(). There is no uid1/uid2
    // field on the document itself, so membership checks below key off
    // `participants` instead.
    match /Chats/{chatId} {
      // Safe to use ONLY directly inside this /Chats/{chatId} match block,
      // where `resource` correctly refers to the Chat document.
      function isParticipant() {
        return isAuth() && request.auth.uid in resource.data.participants;
      }
      function willBeParticipant() {
        return isAuth() && request.auth.uid in request.resource.data.participants;
      }

      allow read:   if isParticipant();
      allow create: if willBeParticipant();
      // Participants can update chat metadata (last message, typing, etc.)
      // but cannot change who the participants are.
      allow update: if isParticipant()
                    && request.resource.data.participants == resource.data.participants;
      allow delete: if false;

      // ── Messages sub-collection ──────────────────────────────────────────
      // Inside this nested match, `resource` refers to the MESSAGE document,
      // not the parent Chat, so the parent Chat doc must be fetched
      // explicitly with get() to check membership.
      function isChatParticipant() {
        let chat = get(/databases/$(database)/documents/Chats/$(chatId)).data;
        return isAuth() && request.auth.uid in chat.participants;
      }

      match /Messages/{msgId} {
        allow read:   if isChatParticipant();
        allow create: if isChatParticipant()
                      && request.resource.data.senderId == request.auth.uid;
        allow update: if isChatParticipant();   // edit / reactions / pin / delete flag
        allow delete: if false;                 // soft-delete via isDeleted flag
      }
    }

    // ── Group chats ────────────────────────────────────────────────────────
    // GroupModel.toMap() writes the member list as `members` — see
    // chat_cubit.dart's GroupModel — there is no `memberUids` field on the
    // document, so membership checks below key off `members` instead.
    match /Groups/{groupId} {
      // Safe to use ONLY directly inside this /Groups/{groupId} match block.
      function isMember() {
        return isAuth() &&
               request.auth.uid in resource.data.members;
      }
      function willBeMember() {
        return isAuth() &&
               request.auth.uid in request.resource.data.members;
      }

      allow read:   if isMember();
      allow create: if willBeMember()
                    && request.resource.data.adminUid == request.auth.uid;
      // Any member can update general group fields (name, photo, settings),
      // but only the current admin can change who the admin is or who the
      // members are — otherwise any member could self-promote or hijack
      // the group by rewriting these fields directly.
      allow update: if isMember() && (
            resource.data.adminUid == request.auth.uid
         || !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['adminUid', 'members'])
      );
      allow delete: if isAuth() && resource.data.adminUid == request.auth.uid;

      // Inside this nested match, `resource` would refer to the MESSAGE doc
      // (no `members` field), so the parent Group doc must be fetched
      // explicitly with get() to check membership.
      function isGroupMember() {
        return isAuth() &&
          request.auth.uid in
            get(/databases/$(database)/documents/Groups/$(groupId)).data.members;
      }

      match /Messages/{msgId} {
        allow read:   if isGroupMember();
        // 'system' is used for auto-generated messages (e.g. "X left the
        // group") — see ChatCubit.leaveGroup().
        allow create: if isGroupMember()
                      && (request.resource.data.senderId == request.auth.uid
                          || request.resource.data.senderId == 'system');
        allow update: if isGroupMember();
        allow delete: if false;
      }
    }

    // ── Stories ────────────────────────────────────────────────────────────
    match /Stories/{storyId} {
      allow read:   if isAuth();
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update: if isMine(resource.data.uid)
                    && request.resource.data.uid == resource.data.uid;
      allow delete: if isMine(resource.data.uid);

      // ── Story comments sub-collection ───────────────────────────────────
      match /Comments/{commentId} {
        allow read:   if isAuth();
        allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
        allow delete: if isAuth() && resource.data.uid == request.auth.uid;
        allow update: if false; // story comments aren't editable in-app
      }
    }

    // ── Reports ────────────────────────────────────────────────────────────
    match /Reports/{reportId} {
      // Reports are submit-only from the client; reporter identity is
      // locked to the caller so reports can't be forged as coming from
      // someone else. Reviewing reports happens via the admin console /
      // Cloud Functions, not the client SDK, so no client read/update.
      allow create: if isAuth() && request.resource.data.reportedBy == request.auth.uid;
      allow read, update, delete: if false;
    }

    // ── Catch-all: deny everything else ───────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
