# ─────────────────────────────────────────────────────────────────────────────
#  .gitattributes  — enforce LF line endings for all text files
#  Prevents CRLF/LF mixed files that caused issues in message_model.dart
# ─────────────────────────────────────────────────────────────────────────────

* text=auto eol=lf

# Force binary for common binary formats
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary
*.zip binary
*.jar binary
*.apk binary
*.aab binary
*.ipa binary
*.pdf binary
*.keystore binary
*.jks binary
